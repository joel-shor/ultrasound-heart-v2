# Copy to .env (gitignored) and populate deployment routing values.
# Never put raw secret tokens here -- only Beaker workspace/budget/dataset IDs
# and names of secrets stored inside your Beaker workspace.

BEAKER_WORKSPACE=ai1/aibd-binder-pairs-db
BEAKER_BUDGET=ai1/aipbd-general
BEAKER_GH_TOKEN_SECRET=GITHUB_TOKEN

# Beaker dataset ID containing curated 4 kHz Parquet files (mounted at /data)
BEAKER_DATA_DATASET=
